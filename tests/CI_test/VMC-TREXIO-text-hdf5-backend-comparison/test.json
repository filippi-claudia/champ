{
  "description": "The same butadiene VMC run read once through the TREXIO HDF5 backend and once through the text backend must give identical energies",
  "labels": [
    "VMC",
    "TREXIO",
    "backend",
    "butadiene"
  ],
  "requires": [
    "trexio"
  ],
  "timeout": 2400,
  "cases": [
    {
      "name": "np1",
      "runs": [
        {
          "program": "vmc",
          "input": "vmc_opt_ci1010_pVTZ_1522_hdf5.inp",
          "output": "vmc_opt_ci1010_pVTZ_1522_hdf5_core_1.out",
          "nproc": 1
        },
        {
          "program": "vmc",
          "input": "vmc_opt_ci1010_pVTZ_1522_text.inp",
          "output": "vmc_opt_ci1010_pVTZ_1522_text_core_1.out",
          "nproc": 1
        }
      ],
      "checks": [
        {
          "type": "value",
          "file": "vmc_opt_ci1010_pVTZ_1522_hdf5_core_1.out",
          "match": "total E",
          "value": -25.7596824,
          "error": 0.2619768,
          "comment": "HDF5 backend"
        },
        {
          "type": "value",
          "file": "vmc_opt_ci1010_pVTZ_1522_text_core_1.out",
          "match": "total E",
          "value": -25.7596824,
          "error": 0.2619768,
          "comment": "text backend"
        },
        {
          "type": "values_equal",
          "files": [
            "vmc_opt_ci1010_pVTZ_1522_hdf5_core_1.out",
            "vmc_opt_ci1010_pVTZ_1522_text_core_1.out"
          ],
          "match": "total E",
          "comment": "both backends must produce bit-identical energies"
        }
      ]
    }
  ]
}

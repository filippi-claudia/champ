          "output": "dump_core_2.out",
          "nproc": 2,
          "error_output": "error_dump",
          "before": [
            {
              "op": "remove",
              "paths": [
                "restart_dmc*"
              ]
            }
          ]
        },
        {
          "program": "dmc",
          "input": "restore_continue.inp",
          "output": "restore_continue_core_2.out",
          "nproc": 2,
          "error_output": "error_restore",
          "after": [
            {
              "op": "concat",
              "sources": [
                "uninterrupted_core_2.out",

%module general
    title        'butadiene DMC forces - restore and continue'
    pool         'pool/'
    pseudopot    BFD
    basis        BFD-T
    mode         'dmc_one_mpi1'
    iforce_analy 1
    dmc_ivd      1
    nwprod       3
%endmodule

load molecule        $pool/champ_v3_butadiene.xyz
load basis_num_info  $pool/champ_v3_BFD-T_basis_pointers.bfinfo

load determinants    TZ_1M_500.det
load orbitals        champ_v3_trexio_order_ci1010_pVTZ_1_orbitals.lcao
load jastrow         jastrow_good_b3lyp.0
load jastrow_der     jastrow.der
load symmetry        ci1010_pVTZ_1_symmetry.sym

%module electrons
    nup           11
    nelec         22
%endmodule

%module blocking_dmc
    dmc_nstep     20
    dmc_nblk      5
    dmc_nblkeq    0
    dmc_nconf     20
    dmc_nconf_new 0
    dmc_idump     0
    dmc_irstar    1
%endmodule

%module dmc
    tau           0.05
    etrial      -26.3d0
    icasula      -1
%endmodule

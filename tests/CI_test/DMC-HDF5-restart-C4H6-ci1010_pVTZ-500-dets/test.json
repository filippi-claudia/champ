        },
        {
          "type": "difference",
          "file": "reference_and_restart_core_2.out",
          "match": "total energy ( 0)",
          "minuend": -1,
          "subtrahend": 1,
          "value": 0.0,
          "error": 0.0,
          "comment": "restarted run minus uninterrupted run, both ten blocks: they must agree within their own combined error bars. No reference energy is hard coded here, so this check travels across compilers."
        },
        {
          "type": "value",
          "file": "restore_continue_core_2.out",
          "match": "weights",
          "value": 19.7992969,
          "error": 0.162123,
          "comment": "wcum_dmc/pass_proc, so it has to come out near dmc_nconf. It is the sharpest probe of the block bookkeeping the restart has to carry over."
        },
        {
          "type": "value",
          "file": "restore_continue_core_2.out",
          "match": "total energy ( 0)",
          "value": -26.270914,
          "error": 0.0167207
        },
        {
          "type": "value",
          "file": "restore_continue_core_2.out",
          "match": "total energy ( 100)",
          "value": -26.2691465,
          "error": 0.0167872,
          "comment": "growth estimator; its error bar is what the wgcm2/egcm2/pecm2_dmc/tpbcm2_dmc datasets restore"
        }
      ]
    },
    {
      "name": "np2-force_analy",
      "comment": "Same dump and restart with iforce_analy and dmc_ivd on, so the checkpoint has to carry the Force Analytical group: the da_* cumulants plus the per-walker deriv_eold, esnake and ehist that each have to find their way back to the rank they came from.",
      "runs": [
        {
          "program": "dmc",
          "input": "dump_force_analy.inp",
          "output": "dump_fa_core_2.out",
          "nproc": 2,
          "error_output": "error_dump_fa",
          "before": [
            {
              "op": "remove",
              "paths": [
                "restart_dmc*"
              ]
            }
          ]
        },
        {
          "program": "dmc",
          "input": "restore_continue_force_analy.inp",
          "output": "restore_continue_fa_core_2.out",
          "nproc": 2,
          "error_output": "error_restore_fa"
        }
      ],
      "checks": [
        {
          "type": "file_exists",
          "file": "restart_dmc.hdf5"
        },
        {
          "type": "value",
          "file": "restore_continue_fa_core_2.out",
          "match": "weights",
          "value": 19.7992969,
          "error": 0.162123
        },
        {
          "type": "value",
          "file": "restore_continue_fa_core_2.out",
          "match": "total energy ( 0)",
          "value": -26.270914,
          "error": 0.0167207
        },
        {
          "type": "value",
          "file": "restore_continue_fa_core_2.out",
          "match": "total energy ( 100)",
          "value": -26.2691465,
          "error": 0.0167872
        }
      ]
    }
  ]
}
